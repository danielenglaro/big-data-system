# Template delle variabili d'ambiente.
# Copiare questo file in ".env" e inserire i valori VERI (il .env NON va committato).
#
#   cp .env.example .env
#
# MONGO_URI: stringa di connessione a MongoDB.
#   - Atlas (cloud, consigliato per il gruppo):
#       mongodb+srv://utente:password@cluster.xxxxx.mongodb.net/
#   - Locale via Docker:
#       mongodb://localhost:27017/
MONGO_URI=mongodb+srv://utente:password@cluster.xxxxx.mongodb.net/

# Nome del database usato dal progetto.
MONGO_DB=spotify_bigdata
